FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=gridpulse
FALKORDB_CONNECT_ATTEMPTS=5
PORT=8000
# Optional audit database override; defaults to ./data/audit_log.db
# GRIDPULSE_AUDIT_DB=/absolute/path/audit_log.db

# Compose host port; change if another database already uses 6379
FALKORDB_HOST_PORT=6379

# LLM advisor on Groq (POST /api/mcp/agent/advise). Leave unset to disable it (503 AGENT_UNAVAILABLE).
# GROQ_API_KEY=
# GRIDPULSE_AGENT_MODEL=openai/gpt-oss-120b

# Public-demo limits for Groq-backed features (advisor, AI operator, Ask the Grid)
# GRIDPULSE_AI_ENABLED=1
# GRIDPULSE_AI_PER_HOUR=60
# GRIDPULSE_AI_PER_USER_10MIN=10
